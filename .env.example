# Hitzeleiter Environment Configuration
# Copy this to .env and customize as needed

# Rust debugging
RUST_BACKTRACE=1

# Logging configuration
# Options: error, warn, info, debug, trace
RUST_LOG=info

# Optional: Enable verbose logging for specific crates
# RUST_LOG=hitzeleiter=debug,convenient_bitbake=debug

# Network configuration (for fetching dependencies)
# Claude Code on web needs "Limited" or "Full Internet" access
# Default allowlist includes: crates.io, github.com, docs.rs

# Optional: HTTP proxy configuration
# http_proxy=http://proxy.example.com:8080
# https_proxy=http://proxy.example.com:8080

# Optional: Remote cache configuration (when implemented)
# HITZELEITER_REMOTE_CACHE_URL=https://cache.example.com
# HITZELEITER_REMOTE_CACHE_TOKEN=your-token-here

# Optional: Build configuration
# HITZELEITER_CACHE_DIR=./build/.hitzeleiter-cache
# HITZELEITER_BUILD_DIR=./build
